<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FoundryBlazorFaktur</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.*" PrivateAssets="all" />
  </ItemGroup>

  <!-- Foundry ships as static files. Copy them from the repo (dist/ + the Blazor
       interop) into wwwroot/foundry before static web assets are gathered, so they
       serve as normal wwwroot assets. wwwroot/foundry is git-ignored (generated). -->
  <Target Name="CopyFoundryAssets" BeforeTargets="ResolveStaticWebAssetsInputs;Build">
    <ItemGroup>
      <_FoundrySrc Include="..\..\dist\foundry.bundle.css;..\..\dist\foundry.js;..\..\adapters\blazor\foundry-blazor.js" />
    </ItemGroup>
    <Copy SourceFiles="@(_FoundrySrc)" DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\foundry" SkipUnchangedFiles="true" />
  </Target>

</Project>
