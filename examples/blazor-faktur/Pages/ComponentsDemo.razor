@namespace FreedayBlazorFaktur.Pages

@* Consumption demo for the native Blazor components (Phase 1): a typed <FdyCombo> bound
   with @bind-Value and an <FdyModal> bound with @bind-Open. Proves the RCL is usable from a
   real app with no manual JS-interop wiring in the page. *@
<section class="fdy-card" style="max-width:32rem"><div class="fdy-card__body">
    <h2 class="fdy-card__title" style="margin-bottom:var(--space-5)">Komponen native Blazor</h2>

    <label class="fdy-field" style="max-width:none">
        <span class="fdy-label" id="demo-status-lbl">Status faktur</span>
        <FdyCombo TValue="string" @bind-Value="_status" Options="_statusOptions" AriaLabelledby="demo-status-lbl" />
    </label>

    <p style="margin-top:var(--space-4)">Terpilih: <strong>@_status</strong></p>

    <label class="fdy-field" style="max-width:none">
        <span class="fdy-label">Tanggal jatuh tempo</span>
        <FdyDatepicker @bind-Value="_tanggal" Label="Tanggal jatuh tempo" Placeholder="Pilih tanggal" />
    </label>

    <p style="margin-top:var(--space-4)">Tanggal: <strong>@(string.IsNullOrEmpty(_tanggal) ? "—" : _tanggal)</strong></p>

    <label class="fdy-field" style="max-width:none">
        <span class="fdy-label">Kota</span>
        <FdyAutocomplete @bind-Value="_kota" Options="_kotaOptions" Placeholder="Ketik kota…" AriaLabel="Kota" />
    </label>
    <p style="margin-top:var(--space-4)">Kota: <strong>@(string.IsNullOrEmpty(_kota) ? "—" : _kota)</strong></p>

    <label class="fdy-field" style="max-width:none">
        <span class="fdy-label">Kategori</span>
        <FdyCascade @bind-Value="_kategori" Nodes="_kategoriNodes" Label="Kategori" Placeholder="Pilih kategori…" />
    </label>
    <p style="margin-top:var(--space-4)">Kategori: <strong>@(string.IsNullOrEmpty(_kategori) ? "—" : _kategori)</strong></p>

    <label class="fdy-field" style="max-width:none">
        <span class="fdy-label">Rentang tanggal</span>
        <FdyDateRange @bind-From="_dari" @bind-To="_sampai" AriaLabel="Rentang tanggal" FromPlaceholder="Dari" ToPlaceholder="Sampai" />
    </label>
    <p style="margin-top:var(--space-4)">Rentang: <strong>@(string.IsNullOrEmpty(_dari) ? "—" : _dari)</strong> → <strong>@(string.IsNullOrEmpty(_sampai) ? "—" : _sampai)</strong></p>

    <div class="fdy-field" style="max-width:none">
        <span class="fdy-label" id="demo-cfl-lbl">Pelanggan (choose-from-list)</span>
        <FdyCfl TRow="Customer" @bind-Value="_customer" LoadPage="LoadCustomers" Columns="_customerCols"
                Display="@(c => c.Name)" RowKey="@(c => c.Id)" Title="Pilih pelanggan"
                Placeholder="Pilih pelanggan…" SearchPlaceholder="Cari pelanggan…" AriaLabelledby="demo-cfl-lbl" />
    </div>
    <p style="margin-top:var(--space-4)">Pelanggan: <strong>@(_customer is null ? "—" : $"{_customer.Id} · {_customer.Name}")</strong></p>

    <button class="fdy-btn fdy-btn--primary" type="button" @onclick="OpenModal">Konfirmasi</button>

    <FdyModal @bind-Open="_modalOpen" Title="Konfirmasi faktur" Size="sm">
        <ChildContent>
            <p>Simpan faktur dengan status <strong>@_status</strong>?</p>
        </ChildContent>
        <FooterContent>
            <button class="fdy-btn fdy-btn--ghost" type="button" @onclick="CloseModal">Batal</button>
            <button class="fdy-btn fdy-btn--primary" type="button" @onclick="CloseModal">Simpan</button>
        </FooterContent>
    </FdyModal>
</div></section>

@* Phase 3: native <FdyTable>, <FdyChart> and <FdyDrawer>. *@
<section class="fdy-card" id="demo-phase3" style="max-width:52rem;margin-top:var(--space-6)"><div class="fdy-card__body">
    <h2 class="fdy-card__title" style="margin-bottom:var(--space-5)">Table, Chart & Drawer</h2>

    <div style="max-width:20rem;margin-bottom:var(--space-6)">
        <FdyChart Type="donut" Values="_cityValues" Labels="_cityLabels" Format="currency"
                  Center="Rp 35,9jt" AriaLabel="Pendapatan per kota" />
    </div>

    <FdyTable TRow="Invoice" Columns="_invoiceCols" Rows="_invoices" RowKey="@(i => i.Code)"
              PageSize="3" RowActivatable="true" RowActivate="OnInvoiceActivate"
              AriaLabel="Daftar faktur" />
    <p style="margin-top:var(--space-4)">Baris aktif: <strong>@(_activeInvoice is null ? "—" : $"{_activeInvoice.Code} · {_activeInvoice.Customer}")</strong></p>

    <button class="fdy-btn fdy-btn--primary" type="button" @onclick="@(() => _drawerOpen = true)" style="margin-top:var(--space-4)">Buka panel</button>

    <FdyDrawer @bind-Open="_drawerOpen" Title="Detail faktur" Side="right">
        <ChildContent>
            @if (_activeInvoice is not null)
            {
                <dl class="fdy-field" style="max-width:none">
                    <div><span class="fdy-label">Kode</span> <strong class="fdy-mono">@_activeInvoice.Code</strong></div>
                    <div style="margin-top:var(--space-3)"><span class="fdy-label">Pelanggan</span> <strong>@_activeInvoice.Customer</strong></div>
                    <div style="margin-top:var(--space-3)"><span class="fdy-label">Kota</span> <strong>@_activeInvoice.City</strong></div>
                    <div style="margin-top:var(--space-3)"><span class="fdy-label">Total</span> <strong class="fdy-mono">Rp @_activeInvoice.Total.ToString("N0")</strong></div>
                </dl>
            }
            else
            {
                <p>Pilih satu baris faktur untuk melihat detail.</p>
            }
        </ChildContent>
        <FooterContent>
            <button class="fdy-btn fdy-btn--primary" type="button" @onclick="@(() => _drawerOpen = false)">Tutup</button>
        </FooterContent>
    </FdyDrawer>
</div></section>
