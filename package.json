{
  "name": "@cahyo-dimas/freeday",
  "version": "2.1.0",
  "description": "Freeday: token-driven, framework-agnostic UI KIT (design source-of-truth).",
  "type": "module",
  "license": "MIT",
  "sideEffects": true,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cahyo-dimas/freeday-ui-kit.git"
  },
  "homepage": "https://cahyo-dimas.github.io/freeday-ui-kit/docs/",
  "bugs": {
    "url": "https://github.com/cahyo-dimas/freeday-ui-kit/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src/base.css",
    "src/components",
    "adapters",
    "tokens/tokens.json",
    "tokens/breakpoints.mjs",
    "tokens/breakpoints.d.ts",
    "README.md",
    "README.id.md",
    "USAGE.md",
    "COMPONENTS.md",
    "CHANGELOG.md",
    "docs/getting-started.md",
    "docs/integrations.md",
    "docs/agent-onboarding.md",
    "docs/reference-screen.html"
  ],
  "exports": {
    ".": {
      "types": "./dist/freeday.d.ts",
      "default": "./dist/freeday.js"
    },
    "./css": {
      "types": "./dist/asset.d.ts",
      "default": "./dist/freeday.bundle.css"
    },
    "./css/components": {
      "types": "./dist/asset.d.ts",
      "default": "./dist/freeday.css"
    },
    "./tokens": {
      "types": "./dist/asset.d.ts",
      "default": "./dist/freeday.tokens.css"
    },
    "./breakpoints": {
      "types": "./tokens/breakpoints.d.ts",
      "default": "./tokens/breakpoints.mjs"
    },
    "./table-model": {
      "types": "./adapters/core/table-model.d.ts",
      "default": "./adapters/core/table-model.js"
    },
    "./enhancers/*": {
      "types": "./dist/asset.d.ts",
      "default": "./dist/freeday-*.js"
    },
    "./vue": {
      "types": "./adapters/vue/index.d.ts",
      "default": "./adapters/vue/index.js"
    },
    "./react": {
      "types": "./adapters/react/index.d.ts",
      "default": "./adapters/react/index.js"
    },
    "./blazor": "./adapters/blazor/freeday-blazor.js",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": "^3.4.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node tokens/build.mjs",
    "test": "node --test",
    "test:browser": "node --test --test-concurrency=3 browser/vanilla.mjs browser/adapter.mjs browser/layout.mjs browser/theme.mjs browser/state.mjs browser/root-init.mjs browser/upload-states.mjs browser/number.mjs browser/card-stretch.mjs browser/text-override.mjs browser/control-heights.mjs browser/cfl-multi.mjs browser/crowding.mjs browser/over-dialog.mjs browser/chart-scale.mjs browser/overlay-stack.mjs browser/chart-a11y.mjs browser/app-shell.mjs browser/picker-states.mjs",
    "prepack": "node tokens/build.mjs",
    "version": "node tokens/build.mjs && git add dist",
    "typecheck:react": "tsc -p adapters/react/tsconfig.json --noEmit",
    "test:blazor": "dotnet test test/blazor -v quiet --nologo"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "esbuild": "^0.28.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vue": "^3.5.40"
  }
}
