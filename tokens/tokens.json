  "primary": { "_comment": { "$value": "Alias ramp. The primary semantics read THESE, never a brand ramp directly, so swapping a palette is eight declarations under [data-primary] instead of re-deriving every semantic token twice (once per theme). Only the eight shades the semantics actually consume are aliased." },
    "50": { "$value": "{azure.50}" }, "100": { "$value": "{azure.100}" }, "300": { "$value": "{azure.300}" }, "400": { "$value": "{azure.400}" }, "500": { "$value": "{azure.500}" }, "600": { "$value": "{azure.600}" }, "700": { "$value": "{azure.700}" }, "800": { "$value": "{azure.800}" } },
  "neutral": { "_comment": { "$value": "Alias ramp for every grey in the kit: surfaces, borders, inks, chart grid, and the noir palette. Semantic tokens read THESE, never a neutral ramp directly, so [data-neutral] re-points fourteen declarations instead of re-deriving every semantic per theme. The default is slate, and it must equal the slate entry of $neutrals (asserted in test/build.test.mjs)." },
    "0": { "$value": "{slate.0}" }, "50": { "$value": "{slate.50}" }, "100": { "$value": "{slate.100}" }, "200": { "$value": "{slate.200}" }, "300": { "$value": "{slate.300}" }, "400": { "$value": "{slate.400}" }, "450": { "$value": "{slate.450}" }, "500": { "$value": "{slate.500}" }, "600": { "$value": "{slate.600}" }, "700": { "$value": "{slate.700}" }, "800": { "$value": "{slate.800}" }, "850": { "$value": "{slate.850}" }, "900": { "$value": "{slate.900}" }, "950": { "$value": "{slate.950}" } },
  "slate": {
    "0": { "$value": "#ffffff" }, "50": { "$value": "#f7f8fa" },
    "100": { "$value": "#eef0f4" }, "200": { "$value": "#e0e3ea" },
    "300": { "$value": "#cbd0da" }, "400": { "$value": "#99a1b3" }, "450": { "$value": "#798295" },
    "500": { "$value": "#6b7488" }, "600": { "$value": "#4d5568" },
    "700": { "$value": "#3a4152" }, "800": { "$value": "#262b38" }, "850": { "$value": "#1c2130" },
    "900": { "$value": "#171b26" }, "950": { "$value": "#0e111a" }
  },
  "grey": { "_comment": { "$value": "The hueless neutral. Each shade keeps the OKLCH lightness of the slate shade with the same number and sets chroma to 0, so every contrast ratio the gate measures for slate moves by a few hundredths at most. Computed once, committed as literals; the build does no OKLCH maths." },
    "0": { "$value": "#ffffff" }, "50": { "$value": "#f8f8f8" },
    "100": { "$value": "#f0f0f0" }, "200": { "$value": "#e3e3e3" },
    "300": { "$value": "#d0d0d0" }, "400": { "$value": "#a1a1a1" }, "450": { "$value": "#828282" },
    "500": { "$value": "#747474" }, "600": { "$value": "#555555" },
    "700": { "$value": "#414141" }, "800": { "$value": "#2b2b2b" }, "850": { "$value": "#222222" },
    "900": { "$value": "#1b1b1b" }, "950": { "$value": "#111111" }
  },
  "stone": { "_comment": { "$value": "The warm neutral. Each shade keeps the OKLCH lightness of the slate shade with the same number, at hue 70 and chroma min(0.85 x slate's chroma, 0.020); shades 800 to 950 cap chroma at 0.012 instead, because 0.020 read as brown on a dark surface. Computed once, committed as literals; the build does no OKLCH maths." },
    "0": { "$value": "#ffffff" }, "50": { "$value": "#f9f8f6" },
    "100": { "$value": "#f2efed" }, "200": { "$value": "#e7e2dd" },
    "300": { "$value": "#d5cfc7" }, "400": { "$value": "#a99f94" }, "450": { "$value": "#8a8075" },
    "500": { "$value": "#7c7268" }, "600": { "$value": "#5d5449" },
    "700": { "$value": "#484036" }, "800": { "$value": "#2f2a25" }, "850": { "$value": "#25211b" },
    "900": { "$value": "#1f1a15" }, "950": { "$value": "#15110c" }
  },
  "sky": {
    "50": { "$value": "#eff6fd" }, "100": { "$value": "#d6e9fb" },
    "200": { "$value": "#b0d4f6" }, "300": { "$value": "#7bbdef" },
    "400": { "$value": "#47a1e6" }, "500": { "$value": "#1a86dc" },
    "600": { "$value": "#0078d4" }, "700": { "$value": "#0061ac" },
    "800": { "$value": "#004d88" }, "900": { "$value": "#003a67" }
  },
  "red":   { "100": { "$value": "#fee2e2" }, "300": { "$value": "#fca5a5" }, "400": { "$value": "#f87171" }, "500": { "$value": "#ef4444" }, "600": { "$value": "#dc2626" }, "700": { "$value": "#b91c1c" } },
  "amber": { "50": { "$value": "#fffbeb" }, "100": { "$value": "#fef3c7" }, "300": { "$value": "#fcd34d" }, "400": { "$value": "#fbbf24" }, "500": { "$value": "#f59e0b" }, "600": { "$value": "#d97706" }, "700": { "$value": "#b45309" }, "800": { "$value": "#92400e" } },
  "green": { "50": { "$value": "#f0fdf4" }, "100": { "$value": "#dcfce7" }, "300": { "$value": "#86efac" }, "400": { "$value": "#4ade80" }, "500": { "$value": "#22c55e" }, "600": { "$value": "#16a34a" }, "700": { "$value": "#15803d" }, "800": { "$value": "#166534" } },
  "blue":  { "50": { "$value": "#eff6ff" }, "100": { "$value": "#dbeafe" }, "300": { "$value": "#93c5fd" }, "400": { "$value": "#60a5fa" }, "500": { "$value": "#3b82f6" }, "600": { "$value": "#2563eb" }, "700": { "$value": "#1d4ed8" }, "800": { "$value": "#1e40af" } },

  "emerald": { "50": { "$value": "#ecfdf5" }, "100": { "$value": "#d1fae5" }, "300": { "$value": "#6ee7b7" }, "400": { "$value": "#34d399" }, "500": { "$value": "#10b981" }, "600": { "$value": "#059669" }, "700": { "$value": "#047857" }, "800": { "$value": "#065f46" } },
  "lime": { "50": { "$value": "#f7fee7" }, "100": { "$value": "#ecfccb" }, "300": { "$value": "#bef264" }, "400": { "$value": "#a3e635" }, "500": { "$value": "#84cc16" }, "600": { "$value": "#65a30d" }, "700": { "$value": "#4d7c0f" }, "800": { "$value": "#3f6212" } },
  "orange": { "50": { "$value": "#fff7ed" }, "100": { "$value": "#ffedd5" }, "300": { "$value": "#fdba74" }, "400": { "$value": "#fb923c" }, "500": { "$value": "#f97316" }, "600": { "$value": "#ea580c" }, "700": { "$value": "#c2410c" }, "800": { "$value": "#9a3412" } },
  "yellow": { "900": { "$value": "#713f12" }, "50": { "$value": "#fefce8" }, "100": { "$value": "#fef9c3" }, "300": { "$value": "#fde047" }, "400": { "$value": "#facc15" }, "500": { "$value": "#eab308" }, "600": { "$value": "#ca8a04" }, "700": { "$value": "#a16207" }, "800": { "$value": "#854d0e" } },
  "teal": { "50": { "$value": "#f0fdfa" }, "100": { "$value": "#ccfbf1" }, "300": { "$value": "#5eead4" }, "400": { "$value": "#2dd4bf" }, "500": { "$value": "#14b8a6" }, "600": { "$value": "#0d9488" }, "700": { "$value": "#0f766e" }, "800": { "$value": "#115e59" } },
  "cyan": { "50": { "$value": "#ecfeff" }, "100": { "$value": "#cffafe" }, "300": { "$value": "#67e8f9" }, "400": { "$value": "#22d3ee" }, "500": { "$value": "#06b6d4" }, "600": { "$value": "#0891b2" }, "700": { "$value": "#0e7490" }, "800": { "$value": "#155e75" } },
  "indigo": { "200": { "$value": "#c7d2fe" }, "50": { "$value": "#eef2ff" }, "100": { "$value": "#e0e7ff" }, "300": { "$value": "#a5b4fc" }, "400": { "$value": "#818cf8" }, "500": { "$value": "#6366f1" }, "600": { "$value": "#4f46e5" }, "700": { "$value": "#4338ca" }, "800": { "$value": "#3730a3" } },
  "violet": { "200": { "$value": "#ddd6fe" }, "50": { "$value": "#f5f3ff" }, "100": { "$value": "#ede9fe" }, "300": { "$value": "#c4b5fd" }, "400": { "$value": "#a78bfa" }, "500": { "$value": "#8b5cf6" }, "600": { "$value": "#7c3aed" }, "700": { "$value": "#6d28d9" }, "800": { "$value": "#5b21b6" } },
  "purple": { "50": { "$value": "#faf5ff" }, "100": { "$value": "#f3e8ff" }, "300": { "$value": "#d8b4fe" }, "400": { "$value": "#c084fc" }, "500": { "$value": "#a855f7" }, "600": { "$value": "#9333ea" }, "700": { "$value": "#7e22ce" }, "800": { "$value": "#6b21a8" } },
  "fuchsia": { "50": { "$value": "#fdf4ff" }, "100": { "$value": "#fae8ff" }, "300": { "$value": "#f0abfc" }, "400": { "$value": "#e879f9" }, "500": { "$value": "#d946ef" }, "600": { "$value": "#c026d3" }, "700": { "$value": "#a21caf" }, "800": { "$value": "#86198f" } },
  "pink": { "50": { "$value": "#fdf2f8" }, "100": { "$value": "#fce7f3" }, "300": { "$value": "#f9a8d4" }, "400": { "$value": "#f472b6" }, "500": { "$value": "#ec4899" }, "600": { "$value": "#db2777" }, "700": { "$value": "#be185d" }, "800": { "$value": "#9d174d" } },
  "rose": { "50": { "$value": "#fff1f2" }, "100": { "$value": "#ffe4e6" }, "300": { "$value": "#fda4af" }, "400": { "$value": "#fb7185" }, "500": { "$value": "#f43f5e" }, "600": { "$value": "#e11d48" }, "700": { "$value": "#be123c" }, "800": { "$value": "#9f1239" } },

  "$primaries": {
    "_comment": "The primary palette axis. Each entry redefines the eight-shade `primary` ALIAS ramp under [data-primary=\"name\"], so the semantic mapping (which shade is the fill, which is hover, which is the soft wash) is written once and never per palette. `on`/`onDark` are the label ink on a primary fill; both are MEASURED, and every pair is asserted by the contrast suite. `darkShift` pulls the dark aliases one step lighter, for a hue whose 500 sits in the luminance band where neither white nor ink reaches 4.5:1.",
    "azure": { "ramp": "azure", "on": "{neutral.0}", "onDark": "{neutral.0}" },
    "sky": { "ramp": "sky", "on": "{neutral.0}", "onDark": "{neutral.950}" },
    "blue": { "ramp": "blue", "on": "{neutral.0}", "onDark": "{neutral.950}" },
    "indigo": { "ramp": "indigo", "on": "{neutral.0}", "onDark": "{neutral.950}", "darkShift": true },
    "violet": { "ramp": "violet", "on": "{neutral.0}", "onDark": "{neutral.950}", "darkShift": true },
    "purple": { "ramp": "purple", "on": "{neutral.0}", "onDark": "{neutral.950}" },
    "fuchsia": { "ramp": "fuchsia", "on": "{neutral.0}", "onDark": "{neutral.950}" },
    "pink": { "ramp": "pink", "on": "{neutral.0}", "onDark": "{neutral.950}" },
    "rose": { "ramp": "rose", "on": "{neutral.0}", "onDark": "{neutral.950}" },
    "orange": { "ramp": "orange", "on": "{neutral.950}", "onDark": "{neutral.950}" },
    "amber": { "ramp": "amber", "on": "{neutral.950}", "onDark": "{neutral.950}" },
    "yellow": { "on": "{neutral.0}", "onDark": "{neutral.950}",
      "light": { "50": "{yellow.50}", "100": "{yellow.100}", "300": "{yellow.300}", "400": "{yellow.400}", "500": "{yellow.500}", "600": "{yellow.700}", "700": "{yellow.800}", "800": "{yellow.900}" } },
    "lime": { "ramp": "lime", "on": "{neutral.950}", "onDark": "{neutral.950}" },
    "green": { "ramp": "green", "on": "{neutral.950}", "onDark": "{neutral.950}" },
    "emerald": { "ramp": "emerald", "on": "{neutral.950}", "onDark": "{neutral.950}" },
    "teal": { "ramp": "teal", "on": "{neutral.950}", "onDark": "{neutral.950}" },
    "cyan": { "ramp": "cyan", "on": "{neutral.950}", "onDark": "{neutral.950}" },
    "noir": { "on": "{neutral.0}", "onDark": "{neutral.950}",
      "light": { "50": "{neutral.100}", "100": "{neutral.200}", "300": "{neutral.500}", "400": "{neutral.700}", "500": "{neutral.800}", "600": "{neutral.900}", "700": "{neutral.800}", "800": "{neutral.950}" },
      "dark":  { "50": "{neutral.800}", "100": "{neutral.700}", "300": "{neutral.300}", "400": "{neutral.200}", "500": "{neutral.100}", "600": "{neutral.50}", "700": "{neutral.200}", "800": "{neutral.300}" } }
  },
  "$neutrals": {
    "_comment": "The neutral axis. Each entry names the Tier-1 ramp the `neutral` alias points at under [data-neutral=\"name\"]. The build flattens the whole token set once per entry and emits only what differs from the default, so tints mixed over a surface and channel triples follow the neutral with no list kept here. slate is the default and emits nothing.",
    "slate": { "ramp": "slate" },
    "grey": { "ramp": "grey" },
    "stone": { "ramp": "stone" }
  },

  "font": {
    "display": { "$value": "'Sora', ui-sans-serif, system-ui, sans-serif" },
    "body":    { "$value": "'IBM Plex Sans', ui-sans-serif, system-ui, -apple-system, sans-serif" },
    "mono":    { "$value": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, monospace" }
  },
  "text": {
    "xs": { "$value": "0.75rem" }, "sm": { "$value": "0.875rem" }, "base": { "$value": "1rem" },
    "lg": { "$value": "1.125rem" }, "xl": { "$value": "1.25rem" }, "2xl": { "$value": "1.5625rem" },
    "3xl": { "$value": "1.9375rem" }, "4xl": { "$value": "2.4375rem" }, "5xl": { "$value": "3.0625rem" }
  },
  "leading": { "tight": { "$value": "1.2" }, "snug": { "$value": "1.35" }, "normal": { "$value": "1.55" }, "loose": { "$value": "1.75" } },
  "tracking": { "tighter": { "$value": "-0.03em" }, "tight": { "$value": "-0.02em" }, "normal": { "$value": "0" }, "wide": { "$value": "0.06em" } },
  "weight": { "regular": { "$value": "400" }, "medium": { "$value": "500" }, "semibold": { "$value": "600" }, "bold": { "$value": "700" } },

  "space": {
    "0": { "$value": "0" }, "1": { "$value": "0.25rem" }, "2": { "$value": "0.5rem" }, "3": { "$value": "0.75rem", "$compact": "0.625rem" },
    "4": { "$value": "1rem", "$compact": "0.75rem" }, "5": { "$value": "1.25rem", "$compact": "1rem" }, "6": { "$value": "1.5rem", "$compact": "1.25rem" }, "8": { "$value": "2rem" },
    "10": { "$value": "2.5rem" }, "12": { "$value": "3rem" }, "16": { "$value": "4rem" }, "20": { "$value": "5rem" }, "24": { "$value": "6rem" }
  },
  "radius": { "xs": { "$value": "3px" }, "sm": { "$value": "4px" }, "md": { "$value": "6px" }, "lg": { "$value": "10px" }, "xl": { "$value": "14px" }, "full": { "$value": "999px" } },
  "shadow": {
    "1": { "$value": "0 1px 2px rgba(16,14,30,.06)", "$dark": "0 1px 2px rgba(0,0,0,.4)" },
    "2": { "$value": "0 2px 6px rgba(16,14,30,.07),0 1px 2px rgba(16,14,30,.05)", "$dark": "0 2px 6px rgba(0,0,0,.45)" },
    "3": { "$value": "0 4px 16px -2px rgba(16,14,30,.14),0 1px 3px rgba(16,14,30,.10)", "$dark": "0 6px 20px -2px rgba(0,0,0,.6),0 1px 3px rgba(0,0,0,.5)" },
    "4": { "$value": "0 24px 48px -12px rgba(16,14,30,.26),0 2px 8px rgba(16,14,30,.10)", "$dark": "0 28px 56px -12px rgba(0,0,0,.72),0 2px 8px rgba(0,0,0,.5)" },
    "lift":       { "$value": "0 1px 2px rgba(16,14,30,.05),0 16px 34px -14px rgba(16,14,30,.24)", "$dark": "0 1px 2px rgba(0,0,0,.5),0 18px 38px -14px rgba(0,0,0,.72)" },
    "lift-hover": { "$value": "0 2px 4px rgba(16,14,30,.06),0 30px 50px -16px rgba(16,14,30,.33)", "$dark": "0 3px 6px rgba(0,0,0,.55),0 32px 56px -16px rgba(0,0,0,.82)" }
  },
  "dur": { "fast": { "$value": "120ms" }, "base": { "$value": "180ms" }, "slow": { "$value": "280ms" } },
  "ease": { "standard": { "$value": "cubic-bezier(.2,0,0,1)" }, "spring": { "$value": "cubic-bezier(.2,.8,.2,1)" } },
  "control": { "h": { "$value": "2.5rem", "$compact": "2rem", "$touch": "2.75rem" }, "box": { "$value": "1.15rem" }, "switch-w": { "$value": "2.4rem" }, "switch-h": { "$value": "1.35rem" } },
  "bw": { "$value": "1px" },

  "color": {
    "primary":        { "$value": "{primary.600}", "$dark": "{primary.500}" },
    "primary-hover":  { "$value": "{primary.700}", "$dark": "{primary.400}" },
    "primary-active": { "$value": "{primary.800}", "$dark": "{primary.300}" },
    "on-primary":     { "$value": "{neutral.0}",    "$dark": "{neutral.0}" },
    "_comment_primary_alpha": { "$value": "A custom property can NEVER hold color-mix(): the declaration that finally uses it contains var(), so it is assumed valid at parse time and only fails at computed-value time, where the property drops to its INITIAL value instead of to a preceding fallback. There is no earlier line to catch it and @supports cannot reach inside a var() chain. Both of these said color-mix() until v3.7.0, which is why a dark-theme chip on Safari <= 16.1 lost its wash entirely. rgba() over a channel triple is the same colour, stated statically." },
    "primary-soft":   { "$value": "{primary.50}",  "$dark": "rgba({primary.600.rgb}, .2)" },
    "primary-border": { "$value": "{primary.100}", "$dark": "rgba({primary.400.rgb}, .28)" },

    "accent":       { "$value": "{sky.600}", "$dark": "{sky.400}" },
    "accent-hover": { "$value": "{sky.700}", "$dark": "{sky.300}" },
    "on-accent":    { "$value": "{neutral.0}",  "$dark": "#06233f" },
    "on-danger":    { "$value": "{neutral.0}",  "$dark": "{neutral.0}" },
    "danger-btn":   { "$value": "{red.600}",  "$dark": "{red.600}" },

    "surface":   { "$value": "{neutral.0}",   "$dark": "{neutral.950}" },
    "surface-2": { "$value": "{neutral.50}",  "$dark": "{neutral.900}" },
    "surface-3": { "$value": "{neutral.100}", "$dark": "{neutral.800}" },
    "surface-stripe": { "$comment": "The zebra tint: 55% of --color-surface-2 over --color-surface, flattened by the build per theme and per neutral. OPAQUE on purpose, and that is the whole reason it is a token rather than a mix written in the table: a frozen column paints this and scrolls over its neighbours, so a translucent stripe would show the rows travelling underneath it.", "$value": "color-mix(in srgb, {color.surface-2} 55%, {color.surface})" },
    "surface-raised": { "$comment": "How transparent glass may be is decided by the CONTRAST GATE, not by taste: below .79 (light) / .88 (dark) the muted ink and primary-strong stop clearing 4.5:1 once the panel is composited over an arbitrary ground. Measured, and asserted in test/contrast.test.mjs. The frost people actually see comes from --surface-filter's blur, not from the alpha.", "$value": "{color.surface}", "$dark": "{color.surface}", "$glass": "rgba(255,255,255,.82)", "$glassDark": "rgba({neutral.900.rgb},.90)" },
    "scrim":     { "$value": "rgba(10,12,25,.5)", "$comment": "Overlay dim. Deliberately the SAME in both themes: a scrim darkens whatever sits behind it, so it does not flip with the palette. The literal matches the modal/drawer ::backdrop, which states it literally because ::backdrop does not inherit a custom property in every engine." },

    "text":        { "$value": "{neutral.900}", "$dark": "{neutral.100}" },
    "text-muted":  { "$value": "{neutral.600}", "$dark": "{neutral.400}" },
    "text-subtle": { "$comment": "The faintest ink, and the ONLY text tier whose dark value is not the light one's mirror (#053). Light slate-500 on white is 4.69:1 and clears AA on its own; the same primitive on the dark surface is 4.02:1, and the tier is exactly what a placeholder uses — the one line telling an operator what an empty field wants. Dark is slate-450 for that reason: 4.88:1 on --color-surface, which is what every .fdy-input paints itself, so the placeholder clears AA where placeholders actually sit. It is still NOT a body-text tier on the darker surfaces (3.66:1 on surface-3); reaching AA there needs slate-400, which is --color-text-muted, and a subtle that equals muted is not a tier. test/contrast.test.mjs asserts both halves of that split.", "$value": "{neutral.500}", "$dark": "{neutral.450}" },
    "on-brand":    { "$value": "{neutral.0}",   "$dark": "{neutral.0}" },

    "border":        { "$value": "{neutral.200}", "$dark": "{neutral.800}" },
    "border-strong": { "$value": "{neutral.300}", "$dark": "{neutral.700}" },
    "border-muted":  { "$value": "{neutral.100}", "$dark": "{neutral.850}" },
    "control-border": { "$value": "{neutral.450}", "$dark": "{neutral.450}" },
    "switch-thumb": { "$value": "{neutral.0}" },
    "shadow-inset": { "$value": "rgba(16,14,30,.06)" },

    "inverse-surface": { "$value": "{neutral.900}", "$dark": "{neutral.100}" },
    "inverse-text":    { "$value": "{neutral.0}",   "$dark": "{neutral.900}" },

    "success": { "$value": "{green.600}", "$dark": "{green.500}" }, "success-soft": { "$value": "{green.100}", "$dark": "rgba(34,197,94,.18)" },
    "warning": { "$value": "#c2740a",     "$dark": "{amber.500}" }, "warning-soft": { "$value": "{amber.100}", "$dark": "rgba(234,179,8,.18)" },
    "danger":  { "$value": "{red.600}",   "$dark": "{red.400}" },  "danger-soft":  { "$value": "{red.100}",   "$dark": "rgba(248,113,113,.18)" },
    "info":    { "$value": "{blue.600}",  "$dark": "{blue.400}" }, "info-soft":    { "$value": "{blue.100}",  "$dark": "rgba(96,165,250,.18)" },

    "_comment_danger_border": { "$value": "The edge of a row that failed, 40% of --color-danger over --color-border: enough to read as wrong from across the list without the full-strength outline that makes one bad upload shout louder than the dialog around it. Computed at build time (see tokens/build.mjs) because it blends two ROLES, which no channel triple can express — written in the component it was the one non-tone color-mix() left, and like all of them it carried var(), so on Safari <= 16.1 border-color dropped to its initial currentColor and the row drew a black box." },
    "danger-border": { "$value": "color-mix(in srgb, {color.danger} 40%, {color.border})" },

    "primary-strong": { "$value": "{primary.700}", "$dark": "{primary.300}" },
    "success-strong": { "$value": "{green.800}", "$dark": "{green.400}" },
    "warning-strong": { "$value": "{amber.800}", "$dark": "{amber.400}" },
    "danger-strong":  { "$value": "{red.700}",   "$dark": "{red.300}" },
    "info-strong":    { "$value": "{blue.700}",  "$dark": "{blue.300}" },

    "_comment_rgb": { "$value": "Channel triples, the kit's way of putting an alpha on a role. `rgba(var(--color-primary-rgb), .26)` is exactly `color-mix(in srgb, var(--color-primary) 26%, transparent)` and works back to Safari 9; the mix form does not survive Safari <= 16.1, and because it carries var() it fails at computed-value time, where a preceding fallback declaration is never consulted. Each triple MUST stay the channels of the role it is named after, in every theme and every palette; test/color-mix.test.mjs asserts exactly that, scope by scope." },
    "primary-rgb":      { "$value": "{primary.600.rgb}", "$dark": "{primary.500.rgb}" },
    "on-primary-rgb":   { "$value": "{neutral.0.rgb}" },
    "danger-rgb":       { "$value": "{red.600.rgb}",   "$dark": "{red.400.rgb}" },
    "danger-btn-rgb":   { "$value": "{red.600.rgb}" },
    "success-rgb":      { "$value": "{green.600.rgb}", "$dark": "{green.500.rgb}" },
    "warning-rgb":      { "$comment": "The one triple written out rather than referenced: --color-warning's light value is itself a literal (#c2740a, a darkened amber with no ramp step of its own), so there is no reference to follow. The drift that invites is what the per-scope assertion in test/color-mix.test.mjs is for.", "$value": "194,116,10", "$dark": "{amber.500.rgb}" },
    "info-rgb":         { "$value": "{blue.600.rgb}",  "$dark": "{blue.400.rgb}" },
    "surface-rgb":      { "$value": "{neutral.0.rgb}",   "$dark": "{neutral.950.rgb}" },
    "inverse-text-rgb": { "$value": "{neutral.0.rgb}",   "$dark": "{neutral.900.rgb}" }
  },

  "chart": {
    "1": { "$value": "#2a78d6", "$dark": "#3987e5" },
    "2": { "$value": "#eb6834", "$dark": "#d95926" },
    "3": { "$value": "#1baf7a", "$dark": "#199e70" },
    "4": { "$value": "#eda100", "$dark": "#c98500" },
    "5": { "$value": "#e87ba4", "$dark": "#d55181" },
    "6": { "$value": "#008300", "$dark": "#008300" },
    "7": { "$value": "#4a3aa7", "$dark": "#9085e9" },
    "8": { "$value": "#e34948", "$dark": "#e66767" },
    "grid": { "$value": "{neutral.200}", "$dark": "{neutral.800}" },
    "tick": { "$value": "{neutral.400}", "$dark": "{neutral.600}" }
  },

  "_comment_tone": "General categorical palette: the same 8 validated hues as chart, aliased under a chart-neutral name for avatars, chips, tags, legend swatches (theme-follows via chart's own $dark).",
  "_comment_tone_parts": "The four colours a tone modifier is MADE of, computed at build time (tokens/build.mjs flattens the color-mix() below, per theme, and never ships it). They exist as tokens because the alternative does not work: .fdy-avatar--tone-N / .fdy-badge--tone-N / .fdy-chip--tone-N used to inject the hue through a private custom property and mix it in the component, which put var() inside a color-mix() — assumed valid at parse time, invalid at computed-value time, and there the property drops to its INITIAL value rather than to any fallback. On Safari <= 16.1 that left the avatars on a shift-change roster screen with no fill and no ink at all. -bg is the tint the modifier sits on, -ink the text-leaning foreground that keeps it AA (test/contrast.test.mjs measures THESE, not the formula), -border the chip's opaque edge over --color-border, -border-soft the badge's translucent one. Both themes come out of one line each, so a retuned surface retunes every tint derived from it.",
  "tone": {
    "1": { "$value": "{chart.1}" },
    "2": { "$value": "{chart.2}" },
    "3": { "$value": "{chart.3}" },
    "4": { "$value": "{chart.4}" },
    "5": { "$value": "{chart.5}" },
    "6": { "$value": "{chart.6}" },
    "7": { "$value": "{chart.7}" },
    "8": { "$value": "{chart.8}" },

    "1-bg": { "$value": "color-mix(in srgb, {tone.1} 18%, {color.surface})" },
    "2-bg": { "$value": "color-mix(in srgb, {tone.2} 18%, {color.surface})" },
    "3-bg": { "$value": "color-mix(in srgb, {tone.3} 18%, {color.surface})" },
    "4-bg": { "$value": "color-mix(in srgb, {tone.4} 18%, {color.surface})" },
    "5-bg": { "$value": "color-mix(in srgb, {tone.5} 18%, {color.surface})" },
    "6-bg": { "$value": "color-mix(in srgb, {tone.6} 18%, {color.surface})" },
    "7-bg": { "$value": "color-mix(in srgb, {tone.7} 18%, {color.surface})" },
    "8-bg": { "$value": "color-mix(in srgb, {tone.8} 18%, {color.surface})" },

    "1-ink": { "$value": "color-mix(in srgb, {tone.1} 50%, {color.text})" },
    "2-ink": { "$value": "color-mix(in srgb, {tone.2} 50%, {color.text})" },
    "3-ink": { "$value": "color-mix(in srgb, {tone.3} 50%, {color.text})" },
    "4-ink": { "$value": "color-mix(in srgb, {tone.4} 50%, {color.text})" },
    "5-ink": { "$value": "color-mix(in srgb, {tone.5} 50%, {color.text})" },
    "6-ink": { "$value": "color-mix(in srgb, {tone.6} 50%, {color.text})" },
    "7-ink": { "$value": "color-mix(in srgb, {tone.7} 50%, {color.text})" },
    "8-ink": { "$value": "color-mix(in srgb, {tone.8} 50%, {color.text})" },

    "1-border": { "$value": "color-mix(in srgb, {tone.1} 30%, {color.border})" },
    "2-border": { "$value": "color-mix(in srgb, {tone.2} 30%, {color.border})" },
    "3-border": { "$value": "color-mix(in srgb, {tone.3} 30%, {color.border})" },
    "4-border": { "$value": "color-mix(in srgb, {tone.4} 30%, {color.border})" },
    "5-border": { "$value": "color-mix(in srgb, {tone.5} 30%, {color.border})" },
    "6-border": { "$value": "color-mix(in srgb, {tone.6} 30%, {color.border})" },
    "7-border": { "$value": "color-mix(in srgb, {tone.7} 30%, {color.border})" },
    "8-border": { "$value": "color-mix(in srgb, {tone.8} 30%, {color.border})" },

    "1-border-soft": { "$value": "color-mix(in srgb, {tone.1} 26%, transparent)" },
    "2-border-soft": { "$value": "color-mix(in srgb, {tone.2} 26%, transparent)" },
    "3-border-soft": { "$value": "color-mix(in srgb, {tone.3} 26%, transparent)" },
    "4-border-soft": { "$value": "color-mix(in srgb, {tone.4} 26%, transparent)" },
    "5-border-soft": { "$value": "color-mix(in srgb, {tone.5} 26%, transparent)" },
    "6-border-soft": { "$value": "color-mix(in srgb, {tone.6} 26%, transparent)" },
    "7-border-soft": { "$value": "color-mix(in srgb, {tone.7} 26%, transparent)" },
    "8-border-soft": { "$value": "color-mix(in srgb, {tone.8} 26%, transparent)" }
  },

  "surface-filter": { "$value": "none", "$glass": "blur(14px) saturate(150%)" },
  "surface-inset":  { "$comment": "No-op is a transparent zero-size shadow, NOT `none`: this token is appended to box-shadow lists that already have entries, and `box-shadow: 0 1px 2px rgba(0,0,0,.1), none` is invalid CSS — the whole declaration would be dropped, taking the real shadow with it.", "$value": "inset 0 0 0 0 transparent", "$glass": "inset 0 1px 0 rgba(255,255,255,.55)", "$glassDark": "inset 0 1px 0 rgba(255,255,255,.09)" },
  "focus-ring": { "$value": "{primary.600}", "$dark": "{primary.400}" },
  "focus-ring-width": { "$value": "2px" }
}
