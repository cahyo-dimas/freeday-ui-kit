{
  "azure": {
    "50": { "$value": "#eff4ff" }, "100": { "$value": "#dbe6fe" },
    "200": { "$value": "#bdd2fd" }, "300": { "$value": "#90b3fb" },
    "400": { "$value": "#5c8bf6" }, "500": { "$value": "#3467ec" },
